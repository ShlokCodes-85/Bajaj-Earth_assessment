ENVIRONMENT=production
FRONTEND_ORIGIN=https://your-frontend.vercel.app
POLL_INTERVAL_SECONDS=10
DEMO_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
GOOGLE_OAUTH_CLIENT_JSON={"web":{"client_id":"your-client-id","client_secret":"your-client-secret","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","redirect_uris":["https://your-backend.onrender.com/api/auth/google/callback"]}}
GOOGLE_OAUTH_REDIRECT_URI=https://your-backend.onrender.com/api/auth/google/callback
SESSION_SECRET=generate-a-long-random-secret
